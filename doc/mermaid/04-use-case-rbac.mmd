flowchart LR
  subgraph ACTORS["ACTORS"]
    A(["Admin"]):::admin
    T(["Trader"]):::trader
    D(["Driver"]):::driver
  end

  subgraph SHARED["SHARED PLATFORM CAPABILITIES"]
    LOGIN["Login / Logout"]:::core
    MAP["View role-appropriate map"]:::core
    NOTIF["Receive / read notifications"]:::core
  end

  subgraph ADMINUC["ADMIN OPERATIONS"]
    ALL["View all shipments"]:::admin
    ASSIGN["Assign Driver"]:::admin
    REVIEW["Review conflicting / suspicious incidents"]:::admin
    GATE["Create / manage trusted gate knowledge"]:::admin
    OVERRIDE["Manual incident / route-status override"]:::admin
    BCAST["Broadcast operational alert"]:::admin
  end

  subgraph TRADERUC["TRADER SELF-SERVICE"]
    REQ["Create shipment request"]:::trader
    OWN["View own shipments only"]:::trader
    TRACK["Track cargo timeline / map"]:::trader
    PROOF["View documents & delivery proof"]:::trader
  end

  subgraph DRIVERUC["DRIVER FIELD OPERATIONS"]
    TRIP["View assigned trip"]:::driver
    STATUS["Update shipment status"]:::driver
    GPS["Send live / offline GPS"]:::driver
    REPORT["Report existing or new checkpoint"]:::driver
    PHOTO["Upload operational evidence"]:::driver
    REROUTE["Choose / reroute own assigned trip"]:::driver
    OBS["Record unmapped observed route"]:::adaptive
    DEL["Mark delivered + proof"]:::driver
  end

  A --> LOGIN
  T --> LOGIN
  D --> LOGIN
  A --> MAP
  T --> MAP
  D --> MAP
  A --> NOTIF
  T --> NOTIF
  D --> NOTIF
  A --> ALL & ASSIGN & REVIEW & GATE & OVERRIDE & BCAST
  T --> REQ & OWN & TRACK & PROOF
  D --> TRIP & STATUS & GPS & REPORT & PHOTO & REROUTE & OBS & DEL

  NOTE1["Authority split:<br/>Admin = trusted operational information<br/>Driver = field movement & route choice<br/>Trader = own-cargo visibility"]:::muted
  NOTE2["Forbidden examples:<br/>Trader cannot approve incidents<br/>Driver cannot edit another Driver's shipment<br/>Driver cannot directly rewrite official gate status"]:::warn
  A --- NOTE1
  NOTE1 --- NOTE2

