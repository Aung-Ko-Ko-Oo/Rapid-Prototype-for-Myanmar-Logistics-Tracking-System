%%{init: {"theme":"base","flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":34,"rankSpacing":46},"themeVariables":{"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif","fontSize":"15px","primaryTextColor":"#0f172a","lineColor":"#64748b","clusterBkg":"#f8fafc","clusterBorder":"#cbd5e1","edgeLabelBackground":"#ffffff","tertiaryColor":"#f8fafc"}}}%%
flowchart TD
  R1["Driver report received<br/>condition + GPS + time + evidence"]:::driver
  MATCH{{"Nearby active incident / same gate?"}}:::core
  CREATE["Create PENDING incident"]:::warn
  ATTACH["Attach report to existing incident"]:::warn
  EVIDENCE["Recalculate evidence<br/>unique Drivers • recency • location • condition"]:::core
  AGREEMENT{{"Independent reports agree?"}}:::core
  THRESH{{"Consensus threshold met?"}}:::core
  CONF["CONFIRMED<br/>Update route/gate condition + affected alerts"]:::warn
  UNCERTAIN["UNCERTAIN<br/>Preserve conflicting evidence"]:::warn
  ADMIN{{"Manual review required?"}}:::admin
  OVERRIDE["Admin accept / reject / merge / override"]:::admin
  CLEAR{{"Repeated CLEAR observations?"}}:::core
  RESOLVE["RESOLVED<br/>Stop active warning, retain history"]:::success
  ARCH["ARCHIVED<br/>historical evidence only"]:::muted

  R1 --> MATCH
  MATCH -- "No" --> CREATE --> EVIDENCE
  MATCH -- "Yes" --> ATTACH --> EVIDENCE
  EVIDENCE --> AGREEMENT
  AGREEMENT -- "Yes" --> THRESH
  THRESH -- "Yes" --> CONF
  THRESH -- "Not yet" --> CREATE
  AGREEMENT -- "No / contradictory" --> UNCERTAIN --> ADMIN
  ADMIN -- "Yes" --> OVERRIDE --> EVIDENCE
  ADMIN -- "No, await field evidence" --> EVIDENCE
  CONF --> CLEAR
  CLEAR -- "Yes" --> RESOLVE --> ARCH
  CLEAR -- "No" --> CONF

  NOTE["Example auto-confirm rule:<br/>2+ unique Drivers, recent window, same approximate location, same condition"]:::adaptive
  THRESH -.-> NOTE

