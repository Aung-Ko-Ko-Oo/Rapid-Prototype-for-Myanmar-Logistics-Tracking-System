%%{init: {"theme":"base","flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":34,"rankSpacing":46},"themeVariables":{"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif","fontSize":"15px","primaryTextColor":"#0f172a","lineColor":"#64748b","clusterBkg":"#f8fafc","clusterBorder":"#cbd5e1","edgeLabelBackground":"#ffffff","tertiaryColor":"#f8fafc"}}}%%
flowchart LR
  subgraph PROVIDERS["LOCATION PROVIDERS"]
    LIVE["LiveGPSProvider<br/>device geolocation + accuracy"]:::external
    SIM["SimulationProvider<br/>start • pause • next • jump"]:::muted
  end

  LOC["TrackingService<br/>normalizes position events"]:::core
  VALID["GPS Validator<br/>accuracy • impossible jumps • timestamps"]:::core
  BUFFER["Point Buffer / Batch<br/>5–15 sec or movement threshold"]:::core
  NET{{"Online?"}}:::offline
  IDB["IndexedDB<br/>unsent batches"]:::offline
  API["FastAPI<br/>/locations/batch"]:::core
  DB["Supabase<br/>current location + history/events"]:::data
  MAP["Shared LogisticsMap"]:::core
  LEARN{{"Eligible for route reinforcement?"}}:::adaptive
  CONF["Route Confidence Engine"]:::adaptive

  subgraph LAYERS["ROLE-SPECIFIC MAP LAYERS"]
    AM["Admin<br/>all active trucks • incidents • gates"]:::admin
    TM["Trader<br/>own shipment • relevant warnings"]:::trader
    DM["Driver<br/>current route • candidates • observed paths"]:::driver
  end

  LIVE --> LOC
  SIM --> LOC
  LOC --> VALID --> BUFFER --> NET
  NET -- "No" --> IDB -->|"reconnect"| API
  NET -- "Yes" --> API
  API --> DB --> MAP
  MAP --> AM & TM & DM
  API --> LEARN
  LEARN -- "LIVE_GPS + valid movement + success + coverage" --> CONF
  LEARN -- "SIMULATED / invalid / incomplete" --> X["Do not reinforce production confidence"]:::warn

