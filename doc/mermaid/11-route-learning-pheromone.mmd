%%{init: {"theme":"base","flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":34,"rankSpacing":46},"themeVariables":{"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif","fontSize":"15px","primaryTextColor":"#0f172a","lineColor":"#64748b","clusterBkg":"#f8fafc","clusterBorder":"#cbd5e1","edgeLabelBackground":"#ffffff","tertiaryColor":"#f8fafc"}}}%%
flowchart TD
  DISCOVER["Driver leaves known route<br/>or intentionally chooses unmapped path"]:::driver
  RECORD["Record validated GPS breadcrumbs"]:::driver
  NEW["Create DRIVER_OBSERVED route<br/>trust = UNCONFIRMED<br/>confidence = 20"]:::adaptive
  MATCH{{"Later journey substantially matches this route?"}}:::adaptive
  VALID{{"Traversal eligible?<br/>LIVE_GPS • valid movement • success • coverage"}}:::core
  SAME["Successful traversal<br/>+10 confidence"]:::success
  UNIQUE{{"New unique Driver?"}}:::core
  BONUS["Diversity bonus<br/>+10"]:::success
  ISSUE["Confirmed disruption<br/>−20 + operational penalty"]:::warn
  DECAY["Long inactivity<br/>mild −5 decay periods"]:::muted
  SCORE["Recalculate route confidence & recommendation score"]:::adaptive
  CONFIRM{{"confidence ≥ 50<br/>AND ≥ 2 unique successful Drivers?"}}:::adaptive
  TRUST["AUTO-CONFIRMED<br/>confirmation = CROWD_VERIFIED"]:::success
  UNCONF["Remain UNCONFIRMED<br/>still visible with warning"]:::adaptive
  CAND["Candidate routes:<br/>ORS • Admin • Driver-observed"]:::core
  RANK["Rank using confidence<br/>− current disruption penalty<br/>− distance penalty"]:::adaptive
  EXPLAIN["Explain recommendation<br/>recent trips • unique Drivers • incidents • distance"]:::adaptive
  DRIVER["Driver makes final route decision"]:::driver

  DISCOVER --> RECORD --> NEW --> CAND
  MATCH --> VALID
  VALID -- "Yes" --> SAME --> UNIQUE
  UNIQUE -- "Yes" --> BONUS --> SCORE
  UNIQUE -- "No" --> SCORE
  VALID -- "No" --> UNCONF
  ISSUE --> SCORE
  DECAY --> SCORE
  SCORE --> CONFIRM
  CONFIRM -- "Yes" --> TRUST --> CAND
  CONFIRM -- "No" --> UNCONF --> CAND
  CAND --> RANK --> EXPLAIN --> DRIVER
  NEW -. "future Driver journeys" .-> MATCH

  ANT["Ant-colony analogy:<br/>successful independent use reinforces a trail;<br/>blocked or stale trails lose recommendation strength"]:::muted
  SCORE -.-> ANT

classDef admin fill:#eef2ff,stroke:#4f46e5,color:#312e81,stroke-width:2px;
classDef trader fill:#ecfeff,stroke:#0f766e,color:#134e4a,stroke-width:2px;
classDef driver fill:#fffbeb,stroke:#d97706,color:#78350f,stroke-width:2px;
classDef core fill:#f1f5f9,stroke:#334155,color:#0f172a,stroke-width:2px;
classDef data fill:#ecfdf5,stroke:#16a34a,color:#14532d,stroke-width:2px;
classDef external fill:#eff6ff,stroke:#2563eb,color:#1e3a8a,stroke-width:2px;
classDef offline fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:2px;
classDef warn fill:#fef2f2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px;
classDef adaptive fill:#f5f3ff,stroke:#7c3aed,color:#4c1d95,stroke-width:2px;
classDef success fill:#f0fdf4,stroke:#22c55e,color:#14532d,stroke-width:2px;
classDef muted fill:#f8fafc,stroke:#94a3b8,color:#475569,stroke-width:1.5px;
