%%{init: {"theme":"base","flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":34,"rankSpacing":46},"themeVariables":{"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif","fontSize":"15px","primaryTextColor":"#0f172a","lineColor":"#64748b","clusterBkg":"#f8fafc","clusterBorder":"#cbd5e1","edgeLabelBackground":"#ffffff","tertiaryColor":"#f8fafc"}}}%%
flowchart TB
  subgraph CLIENT["USER DEVICES / BROWSER"]
    BROWSER["React / Vite App<br/>Vercel"]:::core
    PUB["Supabase publishable key<br/>safe for browser + RLS"]:::data
    IDB["IndexedDB offline queue"]:::offline
  end

  subgraph SERVER["SERVER TRUST BOUNDARY"]
    API["FastAPI<br/>Render"]:::core
    SECRET["Supabase secret key<br/>server environment only"]:::warn
    ORSKEY["ORS API key<br/>server / protected config as applicable"]:::external
  end

  subgraph SUPA["SUPABASE PROJECT"]
    AUTH["Auth"]:::data
    PG["Postgres + RLS"]:::data
    STORAGE["Private Storage<br/>signed / authorized access"]:::data
    REALTIME["Realtime"]:::data
  end

  subgraph EXT["EXTERNAL"]
    ORS["OpenRouteService"]:::external
    GPS["Device GPS"]:::external
  end

  subgraph FALLBACKS["DEMO RESILIENCE"]
    CACHE["Cached route geometry"]:::muted
    SIM["GPS simulator"]:::muted
    POLL["Refresh / polling if realtime fails"]:::muted
    DEMO["Seeded demo mode + stable tag"]:::muted
  end

  BROWSER --> PUB --> AUTH
  AUTH -- "access token" --> BROWSER
  BROWSER -->|"Bearer token"| API
  API -->|"validate identity / role"| AUTH
  API --> SECRET
  SECRET --> PG
  SECRET --> STORAGE
  PG --> REALTIME --> BROWSER
  IDB -->|"reconnect + client_event_id"| API
  GPS --> BROWSER
  API <-->|"routing"| ORS
  API --> ORSKEY

  ORS -. "failure" .-> CACHE
  GPS -. "permission / device failure" .-> SIM
  REALTIME -. "failure" .-> POLL
  PG -. "catastrophic demo failure" .-> DEMO

  LEAK["If secret appears in Git / prompt:<br/>revoke / rotate → update env → redeploy → verify old key fails"]:::warn
  SECRET -.-> LEAK

