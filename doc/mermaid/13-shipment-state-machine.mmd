stateDiagram-v2
  [*] --> REQUESTED
  REQUESTED --> ASSIGNED: Admin assigns Driver
  REQUESTED --> CANCELLED: request cancelled
  ASSIGNED --> PICKED_UP: Driver confirms pickup
  ASSIGNED --> CANCELLED: cancelled before pickup
  PICKED_UP --> IN_TRANSIT: journey starts / inferred
  IN_TRANSIT --> AT_CHECKPOINT: Driver arrives at checkpoint
  AT_CHECKPOINT --> IN_TRANSIT: checkpoint cleared / continue
  IN_TRANSIT --> CUSTOMS: customs processing
  CUSTOMS --> IN_TRANSIT: continue after customs
  CUSTOMS --> DELIVERED: destination/customs is final handoff
  IN_TRANSIT --> DELIVERED: valid direct delivery
  DELIVERED --> [*]
  CANCELLED --> [*]

  state DELAY_CONDITION {
    [*] --> UNKNOWN
    UNKNOWN --> ON_TIME
    ON_TIME --> DELAYED: ETA / incident indicates delay
    DELAYED --> ON_TIME: recovered / delay cleared
  }

  note right of AT_CHECKPOINT
    Checkpoint may occur repeatedly.
    Every occurrence becomes a shipment_event.
  end note

  note right of DELAY_CONDITION
    Delay is NOT the lifecycle state.
    Example: AT_CHECKPOINT + DELAYED.
  end note
