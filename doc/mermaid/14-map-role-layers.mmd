flowchart LR
  BASE["Base Map + Route Geometry<br/>OpenRouteService / cached GeoJSON"]:::external
  MAP["Shared LogisticsMap Component"]:::core

  subgraph DATA["COMMON MAP DATA"]
    TRUCK["Truck locations"]:::core
    ROUTES["Planned / active / observed routes"]:::adaptive
    GATES["Known + temporary gates"]:::warn
    INCIDENTS["Pending / confirmed disruptions"]:::warn
    HISTORY["Optional GPS travel history"]:::muted
    CONF["Confidence / source / last-use metadata"]:::adaptive
  end

  subgraph ADMIN["ADMIN VIEW"]
    A1["All active shipments"]:::admin
    A2["All gates & incidents"]:::admin
    A3["Pending reports / operations filters"]:::admin
  end

  subgraph TRADER["TRADER VIEW"]
    T1["Own shipment only"]:::trader
    T2["Current route + truck"]:::trader
    T3["Relevant disruptions only"]:::trader
  end

  subgraph DRIVER["DRIVER VIEW"]
    D1["Own assigned trip"]:::driver
    D2["Candidate / observed routes"]:::driver
    D3["Checkpoint markers + report actions"]:::driver
    D4["Route details before explicit selection"]:::driver
  end

  BASE --> MAP
  TRUCK & ROUTES & GATES & INCIDENTS & HISTORY & CONF --> MAP
  MAP --> A1 & A2 & A3
  MAP --> T1 & T2 & T3
  MAP --> D1 & D2 & D3 & D4

  LEG["Visual semantics:<br/>active = emphasized • observed = dashed • disrupted = warning • pending checkpoint = unverified marker"]:::muted
  MAP -.-> LEG

